{
  "//": "Moddable SDK manifest for the CodeSense CoreS3 orb.",
  "//build": "mcconfig -d -m -p esp32/m5stack_cores3   (device on COM3)",
  "//secrets": "WiFi + bridge host live in manifest.local.json (gitignored). Copy manifest.local.example.json to manifest.local.json and fill it in.",
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_net.json",
    "$(MODDABLE)/examples/manifest_piu.json",
    "$(MODULES)/network/websocket/manifest.json",
    "./manifest.local.json"
  ],
  "modules": {
    "main": "./main",
    "net": "./net",
    "ui": "./ui",
    "wire": "../../packages/addon-m5/src/wire",
    "framing": "../../packages/addon-m5/src/framing"
  },
  "config": {
    "transport": "wifi",
    "serial": {
      "//": "used when transport = 'serial' (orb docked via USB-C)",
      "baud": 921600
    }
  },
  "resources": {
    "*-alpha": [
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-16",
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-20",
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-28"
    ]
  },
  "platforms": {
    "esp32/m5stack_cores3": {
      "modules": {}
    }
  }
}
