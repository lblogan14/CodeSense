{
  "//": "Editor/IntelliSense only. Moddable transpiles the TS itself via mcconfig; nothing here is emitted or used at build time.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "wire": ["../../packages/addon-m5/src/wire.ts"],
      "ui": ["./ui.ts"],
      "net": ["./net.ts"]
    }
  },
  "include": ["*.ts", "moddable.d.ts"]
}
