{
  "name": "@codesense/cli",
  "version": "0.1.0",
  "description": "CodeSense — drive Claude Code with a PS5 DualSense controller",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codesense": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
