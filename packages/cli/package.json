    "@codesense/core": "workspace:*",
    "@codesense/hid": "workspace:*",
    "picocolors": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0"
  }
}
