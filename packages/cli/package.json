{
  "name": "code-sense",
  "version": "0.3.0",
  "description": "Drive Claude Code with a PS5 DualSense controller — buttons in, lightbar/haptic agent status out",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codesense": "dist-pkg/index.js"
  },
  "files": [
    "dist-pkg"
  ],
  "keywords": [
    "claude-code",
    "dualsense",
    "ps5",
    "controller",
    "hid",
    "agent",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblogan14/CodeSense.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node dist/index.js start --mock",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "node-hid": "^3.1.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@codesense/backend-pty": "workspace:*",
    "@codesense/backend-sdk": "workspace:*",
    "@codesense/core": "workspace:*",
    "@codesense/hid": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.21.0",
    "picocolors": "^1.1.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
